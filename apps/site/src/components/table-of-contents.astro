---
import type { MarkdownHeading } from "astro";
import { css } from "../../styled-system/css";

interface Props { headings: MarkdownHeading[] }
const headings = Astro.props.headings.filter(({ depth }) => depth >= 2 && depth <= 6);
const rootDepth = Math.min(...headings.map(({ depth }) => depth));
const styles = css({
  textStyle: "meta", mb: "8",
  "@media (min-width: 1360px)": {
    position: "absolute", top: "0", left: "[calc(100% + 24px)]", width: "[200px]", height: "full", mb: "0",
  },
  "& .toc-sticky": { position: "sticky", top: "[120px]" },
  "& .toc-panel": { transition: "[opacity 300ms]" },
  "& .toc-nav": { maxHeight: "[min(55svh, 480px)]", overflowY: "auto", overscrollBehavior: "contain", scrollbarWidth: "[none]", px: "2" },
  "& .toc-list": { position: "relative" },
  "& .toc-item": { position: "relative", transition: "[opacity 350ms, translate 350ms]", transitionDelay: "[var(--toc-delay)]" },
  "& .toc-link": {
    display: "block", fontSize: "[14px]", lineHeight: "[21px]", py: "[1.75px]", pl: "[var(--toc-indent)]", pr: "2",
    whiteSpace: "nowrap", overflow: "hidden", textOverflow: "ellipsis", color: "muted", textDecoration: "none",
    transition: "[color 300ms ease-in-out]", _hover: { color: "secondary" },
    '&[aria-current="location"]': { color: "accent", fontWeight: "medium" },
  },
  "& .toc-marker": {
    position: "absolute", left: "0", width: "[2px]", top: "[var(--toc-top, 0px)]", height: "[var(--toc-height, 24.5px)]",
    pointerEvents: "none", borderRadius: "sm", background: "[linear-gradient(to bottom, var(--colors-accent) 80%, transparent)]",
    boxShadow: "[0 0 6px color-mix(in srgb, var(--colors-accent) 25%, transparent)]",
    transition: "[top 400ms cubic-bezier(.4,0,.2,1), height 400ms, opacity 300ms]",
  },
  "& .toc-footer": { mt: "4", px: "2", color: "muted" },
  "& .toc-divider": { width: "[120px]", height: "[10px]", mb: "3", color: "line" },
  "& .toc-progress": { display: "flex", gap: "2", alignItems: "center", fontVariantNumeric: "tabular-nums" },
  "& .toc-ring": { width: "[14px]", height: "[14px]", flexShrink: "0" },
  "& .toc-ring-value": { stroke: "accent", transition: "[stroke-dashoffset 300ms]" },
  "& .toc-top": { display: "flex", alignItems: "center", gap: "2", minHeight: "11", cursor: "pointer", _hover: { color: "accent" } },
  "& .toc-compact": { display: "none", position: "absolute", inset: "0", height: "[240px]", width: "full", textAlign: "left", cursor: "pointer" },
  "& .toc-rail": { position: "absolute", top: "0", left: "0", width: "8", height: "[240px]", overflow: "visible", color: "line" },
  "& .toc-rail-label": { position: "absolute", left: "9", top: "[var(--toc-rail-y, 0px)]", transform: "translateY(-50%)", maxWidth: "[140px]", transition: "[top 400ms]" },
  "& .toc-current": { display: "block", whiteSpace: "nowrap", overflow: "hidden", textOverflow: "ellipsis" },
  "& .toc-percent": { display: "block", color: "accent" },
  '&[data-compact="true"] .toc-panel': { opacity: "0", pointerEvents: "none" },
  '&[data-compact="true"] .toc-item': { opacity: "0", translate: "[-10px 0]" },
  '&[data-compact="true"] .toc-compact': { display: "block" },
  '&[data-ready="true"] .toc-trigger': { display: "flex" },
  "& .toc-trigger": {
    display: "none", position: "fixed", right: "0", bottom: "[20svh]", zIndex: "20", width: "12", height: "14",
    alignItems: "center", justifyContent: "center", bg: "paper", color: "secondary", borderWidth: "1px", borderColor: "line",
    borderRightWidth: "0", borderLeftRadius: "[16px]", cursor: "pointer", _hover: { color: "accent" },
    "@media (min-width: 1360px)": { display: "none!" },
  },
  "& .toc-dialog": {
    position: "fixed", inset: "auto", bottom: "3", left: "3", width: "[calc(100% - 24px)]", maxWidth: "[none]",
    maxHeight: "[calc(100svh - 80px)]", p: "4", borderRadius: "[20px]", borderWidth: "1px", borderColor: "line",
    bg: "paper", color: "ink", boxShadow: "lg", overflow: "hidden",
    "&::backdrop": { bg: "[rgb(0 0 0 / 0.25)]", backdropFilter: "[blur(3px)]" },
    "& .toc-footer": { display: "none" },
    "& .toc-link": { minHeight: "11", py: "3", whiteSpace: "normal", overflowWrap: "anywhere" },
  },
  "& .toc-dialog-header": { display: "flex", justifyContent: "space-between", alignItems: "center", mb: "2", touchAction: "none" },
  "& .toc-close": { width: "11", height: "11", cursor: "pointer", color: "muted" },
  "@media (max-width: 1199px)": {
    '&[data-ready="true"]': { mb: "0" },
    '&[data-ready="true"] > .toc-sticky': { display: "none" },
  },
});
---
{headings.length > 0 && (
  <aside data-toc class={styles}>
    <div class="toc-sticky">
      <div class="toc-panel" data-toc-panel>
        <nav aria-label="本文目录" class="toc-nav">
          <ul class="toc-list">
            {headings.map(({ depth, slug, text }, index) => (
              <li class="toc-item" style={`--toc-delay:${Math.min(index * 50, 350)}ms;--toc-indent:${14 + (depth - rootDepth) * 8}px`}>
                <a class="toc-link" href={`#${slug}`} title={text}>{text}</a>
              </li>
            ))}
          </ul>
        </nav>
        <div class="toc-footer">
          <svg class="toc-divider" aria-hidden="true" viewBox="0 0 120 10" fill="none"><path d="M2 6 Q20 1 40 5 T80 5 T118 5" stroke="currentColor" /></svg>
          <div class="toc-progress" role="progressbar" aria-label="阅读进度" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
            <svg class="toc-ring" aria-hidden="true" viewBox="0 0 16 16"><circle cx="8" cy="8" r="6" fill="none" stroke="currentColor" stroke-opacity=".25" stroke-width="2" /><circle class="toc-ring-value" cx="8" cy="8" r="6" fill="none" stroke-width="2" pathLength="100" stroke-dasharray="100" stroke-dashoffset="100" transform="rotate(-90 8 8)" /></svg>
            <span data-toc-progress>0%</span>
          </div>
          <button class="toc-top" type="button" data-toc-top><span aria-hidden="true">↑</span> 回到顶部</button>
        </div>
      </div>
      <button class="toc-compact" type="button" aria-label="展开本文目录" tabindex="-1">
        <svg class="toc-rail" aria-hidden="true" viewBox="0 0 32 240" fill="none">
          <path data-toc-rail stroke="currentColor" stroke-width="1.2" />
          <path data-toc-rail-active stroke="var(--colors-accent)" stroke-width="2" pathLength="100" stroke-dasharray="12 88" />
        </svg>
        <span class="toc-rail-label"><span class="toc-current"></span><span class="toc-percent" data-toc-progress>0%</span></span>
      </button>
    </div>
    <button class="toc-trigger" type="button" aria-label="显示目录" aria-haspopup="dialog" aria-controls="toc-dialog" aria-expanded="false">
      <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 6h13M8 12h13M8 18h13M3 6h1M3 12h1M3 18h1" /></svg>
    </button>
    <dialog class="toc-dialog" id="toc-dialog" aria-labelledby="toc-title">
      <div class="toc-dialog-header"><h2 id="toc-title">目录</h2><button type="button" class="toc-close" aria-label="关闭目录">×</button></div>
      <div data-toc-slot></div>
    </dialog>
  </aside>
)}
<script>
  import "~/scripts/table-of-contents";
</script>
