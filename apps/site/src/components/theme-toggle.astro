---
import { iconButton } from "~/styles/ui";
---
<button id="theme-btn" type="button" class={iconButton()} aria-label="切换深色模式" aria-pressed="false" title="切换主题">
  <svg class="theme-moon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 13a9 9 0 0 1-9.8-9.8A9 9 0 1 0 20.8 13Z" /></svg>
  <svg class="theme-sun" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" /></svg>
</button>
<script>
  const syncButton = () => {
    const dark = document.documentElement.classList.contains("dark");
    const button = document.getElementById("theme-btn");
    button?.setAttribute("aria-pressed", String(dark));
    button?.setAttribute("aria-label", dark ? "切换浅色模式" : "切换深色模式");
  };
  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element) || !event.target.closest("#theme-btn")) { return; }
    const dark = document.documentElement.classList.toggle("dark");
    try { localStorage.setItem("theme", dark ? "dark" : "light"); } catch { /* Theme still works when storage is unavailable. */ }
    syncButton();
  });
  document.addEventListener("astro:page-load", syncButton);
  syncButton();
</script>
