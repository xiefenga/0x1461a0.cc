---
import dayjs from "dayjs";
import { css } from "../../styled-system/css";
import { postRow } from "~/styles/ui";

interface Props {
  posts: {
    slug: string;
    title: string;
    created: Date;
    updated: Date;
  }[];
  class?: string;
}

const { posts, class: className = "" } = Astro.props;

// 按年份分组
const postsByYear = posts.reduce(
  (acc, post) => {
    const year = dayjs(post.created).year();
    if (!acc[year]) {
      acc[year] = [];
    }
    acc[year].push(post);
    return acc;
  },
  {} as Record<number, typeof posts>
);

// 按年份倒序排列
const sortedYears = Object.keys(postsByYear)
  .map(Number)
  .sort((a, b) => b - a);
---

<div class:list={[className]}>
  {
    sortedYears.map((year) => (
      <section class={css({ mb: "12" })}>
        <h2 class={css({ fontSize: "xl", fontWeight: "medium", lineHeight: "compact", color: "secondary", fontFamily: "code", mb: "4" })}>
          {year}
        </h2>
        <ul>
          {postsByYear[year].map((post) => (
            <li>
              <a
                class={postRow}
                href={`/post/${post.slug}/`}
              >
                <span
                  title={post.title}
                  class={css({ overflowWrap: "anywhere", minWidth: "0" })}
                >
                  {post.title}
                </span>
                <time datetime={post.created.toISOString()} class={css({ textStyle: "meta", fontFamily: "code", flexShrink: "0", whiteSpace: "nowrap" })}>
                  {dayjs(post.created).format("MM-DD")}
                </time>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</div>
