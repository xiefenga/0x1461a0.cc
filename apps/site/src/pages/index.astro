---
import { css } from "../../styled-system/css";
import BaseLayout from "~/layouts/base-layout.astro";
import PostList from "~/components/post-list.astro";
import { getBlogPosts, getPostSlug } from "~/lib/posts";
const posts = await getBlogPosts();
---
<BaseLayout>
  <header class={css({ mb: "12" })}>
    <div class={css({ display: "flex", alignItems: "baseline", justifyContent: "space-between", gap: "4", flexWrap: "wrap" })}>
      <h1 class={css({ textStyle: "title" })}>posts</h1>
      <a class={css({ textStyle: "meta" })} href="https://legacy.0x1461a0.cc/" target="_blank" rel="noopener noreferrer">旧文章列表 ↗</a>
    </div>
  </header>
  {posts.length > 0 ? (
    <PostList posts={posts.map((post) => ({ slug: getPostSlug(post), title: post.data.title, created: post.data.created, updated: post.data.updated }))} />
  ) : (
    <p class={css({ color: "secondary", py: "12" })}>暂无文章</p>
  )}
</BaseLayout>
