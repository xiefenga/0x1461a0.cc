{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./out/types-node",
    "rootDir": ".",
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "declaration": true,
    "composite": true,
    "types": ["node"]
  },
  "include": ["src/main/**/*", "src/preload/**/*", "electron.vite.config.ts"],
  "exclude": ["node_modules", "out"]
}
